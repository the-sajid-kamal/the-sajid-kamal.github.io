---
// বাংলা "সেবা" পাতা: the Bangla Services page. Lists come from src/data/bn.ts.
// DRAFT TRANSLATION of src/pages/services.astro. Hidden with showServices: false.
import '../../styles/bangla.css';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { site } from '../../site.config';
import { services, formats, process, faq } from '../../data/bn';
import { digits } from '../../i18n/ui';
import { resolveHref, isExternal, isPlaceholder } from '../../lib/util';
const booking = resolveHref('booking', 'bn');
---
{site.showServices ? (
  <Base title="সেবা" description="সাজিদ কামালের কনসাল্টিং, অ্যাডভাইজরি ও বক্তৃতা: ক্যাটাগরি ও ব্র্যান্ড স্ট্র্যাটেজি, গো-টু-মার্কেট, ট্রেড মার্কেটিং, ক্যাম্পেইন, ব্র্যান্ড P&L ও স্টার্টআপ অ্যাডভাইজরি।">
    <section class="page-head">
      <div class="container">
        <p class="eyebrow">সেবা</p>
        <h1 class="page-title">যেসব ব্র্যান্ড <em>বড় হতে</em> চায়, তাদের জন্য বাস্তব সহায়তা।</h1>
        <p class="lead">বাংলাদেশ ও বাইরের উদ্যোক্তা, মার্কেটিং টিম ও ব্যবসার জন্য: এমন স্ট্র্যাটেজি, যা কাজে লাগানো যায়, এমন একজনের কাছ থেকে যিনি প্রতিদিন ব্র্যান্ড গড়েন।</p>
        <div class="actions" style="margin-top: 2rem">
          <a class="btn btn--primary" href={booking} target={isExternal(booking) ? '_blank' : undefined} rel={isExternal(booking) ? 'noopener' : undefined} data-track="booking_click">পরিচিতি কল বুক করুন</a>
          <a class="link-arrow" href="/work/" hreflang="en">পেছনের কাজগুলো দেখুন (ইংরেজিতে) <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="services-title">
      <div class="container">
        <SectionHead num="০১" id="services-title" title="যেসব কাজে সাহায্য করতে পারি" />
        <div class="services-grid">
          {services.map((s, i) => (
            <article class="service-card" data-reveal>
              <span class="service-card__num">{digits('bn', String(i + 1).padStart(2, '0'))}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
              <p class="service-card__proof"><strong>আগে যা করেছি</strong>{s.proof}</p>
              {s.work && <a class="link-arrow service-card__link" href={`/work/${s.work}/`} hreflang="en">সংশ্লিষ্ট কেস স্টাডি (ইংরেজিতে) <span class="arrow" aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="formats-title">
      <div class="container">
        <SectionHead num="০২" id="formats-title" title="একসাথে কাজের ধরন" />
        <div class="formats">
          {formats.map((f) => (
            <article class="format-card" data-reveal>
              <span class:list={['format-card__length', isPlaceholder(f.length) && 'placeholder']}>{f.length}</span>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
              <p class:list={['format-card__price', isPlaceholder(f.price) && 'placeholder']}>{f.price}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="process-title">
      <div class="container">
        <SectionHead num="০৩" id="process-title" title="কীভাবে কাজ হয়" />
        <ol class="steps">
          {process.map((p) => (
            <li class="step" data-reveal><h3>{p.title}</h3><p>{p.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="faq-title">
      <div class="container container--narrow">
        <SectionHead num="০৪" id="faq-title" title="প্রশ্নোত্তর" />
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class:list={[isPlaceholder(f.a) && 'placeholder']}>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </Base>
) : (
  <Base title="সেবা" noindex>
    <section class="page-head"><div class="container"><h1 class="page-title">চলুন কথা বলি।</h1><p class="lead">আপনার প্রজেক্ট নিয়ে <a class="text-link" href="/bn/contact/">যোগাযোগ করুন</a>।</p></div></section>
  </Base>
)}
