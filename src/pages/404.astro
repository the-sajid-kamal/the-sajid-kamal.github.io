---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Page not found" noindex hideCta>
  <section class="page-head" style="border-bottom: 0; min-height: 60vh" data-not-found>
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 class="page-title">This page isn’t <em>on the shelf</em>.</h1>
      <p class="lead">The link may be old, or the page may have moved. Looking for my CV? <a class="text-link" href={site.cv} download data-astro-reload>Download it here</a>.</p>
      <div class="actions" style="margin-top: 2.5rem">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="link-arrow" href="/work/">See the work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link-arrow" href="/writing/">Read the writing <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
