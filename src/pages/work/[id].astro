---
// One project case study. The text comes from src/content/work/<id>.md;
// photos are picked up from src/assets/photos/work/<id>.jpg and <id>-1.jpg, -2.jpg...
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import { photo } from '../../lib/photos';
import { isPlaceholder } from '../../lib/util';
import { markDrafts } from '../../lib/drafts';

export async function getStaticPaths() {
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, index, next } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);
const cover = photo(`work/${id}`);
const gallery = data.gallery.map((g, i) => ({ ...g, img: photo(`work/${id}-${i + 1}`) }));
const hasGalleryPhotos = gallery.some((g) => g.img);
// Unfinished case studies: hide the [bracketed] stand-ins from visitors
const body = data.placeholder && project.rendered?.html ? markDrafts(project.rendered.html) : null;
---
<Base title={data.title} description={data.summary}>
  <article>
    <header class="case-head container">
      <a class="back-link" href="/work/"><span class="arrow" aria-hidden="true">←</span> All work</a>
      <p class="eyebrow">{data.category}</p>
      <h1 class="case-title">{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <dl class="facts">
        <div><dt>Company</dt><dd>{data.client}</dd></div>
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>When</dt><dd>{data.year}</dd></div>
        <div><dt>Focus</dt><dd>{data.focus.join(', ')}</dd></div>
      </dl>
    </header>

    <div class="container">
      <div class="case-media" transition:name={`work-media-${id}`}>
        {cover ? (
          <Image src={cover} alt="" widths={[720, 1080, 1440, 2000]} sizes="(max-width: 1340px) 94vw, 1240px" loading="eager" />
        ) : (
          <CoverArt kicker={data.category} value={data.art.value} label={data.art.label} tone={index + 1} />
        )}
      </div>

      {data.metrics.length > 0 && (
        <ul class="metrics" aria-label="Results">
          {data.metrics.map((m) => (
            <li class="metric" data-reveal>
              <span class="metric__value">{m.value}</span>
              <span class="metric__label">{m.label}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="case-body">
        <div class="prose">
          {data.placeholder && (
            <p class="placeholder-note" role="note" data-draft><strong>Placeholder case study.</strong> Text in [square brackets] and the striped images are stand-ins to replace with your own.</p>
          )}
          {body ? <Fragment set:html={body} /> : <Content />}
        </div>
        <aside class="case-aside" aria-label="Work with me">
          <h2>Facing something similar?</h2>
          <p>I help brands and businesses with {data.focus.slice(0, 2).join(' and ').toLowerCase()}. Tell me about your project.</p>
          <a class="btn btn--primary" href="/contact/?topic=consulting#message">Start a conversation</a>
        </aside>
      </div>

      {gallery.length > 0 && (
        <div class="gallery" data-draft={hasGalleryPhotos ? undefined : ''}>
          {gallery.map((g) => (
            <figure data-reveal data-draft={g.img ? undefined : ''}>
              {g.img ? (
                <Image src={g.img} alt={g.caption && !isPlaceholder(g.caption) ? g.caption : ''} widths={[480, 720, 1000]} sizes="(max-width: 640px) 92vw, 46vw" />
              ) : (
                <div class="ph-box" data-placeholder role="img" aria-label="Photo placeholder">Photo · 3:2</div>
              )}
              {g.caption && <figcaption class:list={[isPlaceholder(g.caption) && 'placeholder']}>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      {data.quote && (
        <figure class="case-quote" data-reveal data-draft={isPlaceholder(data.quote.text) ? '' : undefined}>
          <blockquote class:list={[isPlaceholder(data.quote.text) && 'placeholder']}>{data.quote.text}</blockquote>
          <figcaption class:list={[isPlaceholder(data.quote.name) && 'placeholder']}><strong>{data.quote.name}</strong>{data.quote.role}</figcaption>
        </figure>
      )}

      {next && next.id !== id && (
        <nav class="next-link" aria-label="Next project">
          <p class="eyebrow">Next project</p>
          <a href={`/work/${next.id}/`}>{next.data.title} <span class="arrow" aria-hidden="true">→</span></a>
        </nav>
      )}
    </div>
  </article>
</Base>
