---
// One article. The text comes from src/content/writing/<id>.md;
// a cover photo is picked up from src/assets/photos/writing/<id>.jpg.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../site.config';
import { photo } from '../../lib/photos';
import { formatDate, readingTime, isPlaceholder } from '../../lib/util';
import { markDrafts } from '../../lib/drafts';
import Share from '../../components/Share.astro';
import Newsletter from '../../components/Newsletter.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('writing', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // Finished articles first in "More writing"
  return posts.map((post) => ({ params: { id: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).sort((a, b) => Number(a.data.placeholder) - Number(b.data.placeholder)).slice(0, 3) } }));
}

const { post, others } = Astro.props;
const { data, id } = post;
const { Content } = await render(post);
const cover = photo(`writing/${id}`);
const headshot = photo('headshot');
const body = data.placeholder && post.rendered?.html ? markDrafts(post.rendered.html) : null;
---
<Base title={data.title} description={isPlaceholder(data.excerpt) ? site.description : data.excerpt} type="article" published={data.date} noindex={data.placeholder}>
  <div class="reading-progress" aria-hidden="true" data-reading-progress></div>
  <article data-article data-zone="article">
    <header class="article-head container">
      <a class="back-link" href="/writing/"><span class="arrow" aria-hidden="true">←</span> All writing</a>
      <p class="eyebrow">{data.topic} · {readingTime(post.body)}</p>
      <h1 class="article-title">{data.title}</h1>
      {data.dek && <p class:list={['article-dek', isPlaceholder(data.dek) && 'placeholder']}>{data.dek}</p>}
      <div class="byline">
        <span class="avatar">{headshot ? <Image src={headshot} alt="" width={92} height={92} /> : 'SK'}</span>
        <p><strong>{site.name}</strong><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></p>
      </div>
    </header>

    <div class="container">
      <div class="article-media" transition:name={`post-media-${id}`}>
        {cover ? (
          <Image src={cover} alt="" widths={[720, 1080, 1440, 2000]} sizes="(max-width: 1340px) 94vw, 1240px" loading="eager" />
        ) : (
          <CoverArt kicker={`Essay · ${formatDate(data.date, 'short')}`} value={data.topic} tone={3} variant="title" />
        )}
      </div>

      <div class="prose">
        {data.placeholder && (
          <p class="placeholder-note" role="note"><strong>Placeholder article.</strong> Text in [square brackets] is a stand-in for your own writing.</p>
        )}
        {body ? <Fragment set:html={body} /> : <Content />}
      </div>

      <Share title={data.title} text={isPlaceholder(data.excerpt) ? '' : data.excerpt} label="Share this essay" />

      <aside class="author-box" aria-label="About the author">
        <span class="avatar">{headshot ? <Image src={headshot} alt="" width={128} height={128} /> : 'SK'}</span>
        <p><strong>{site.name}</strong>{site.role} at {site.company}. I write about building brands, retail and how people in Bangladesh shop. <a class="text-link" href="/about/">More about me</a></p>
      </aside>
      <Newsletter />
    </div>
  </article>

  {others.length > 0 && (
    <section class="section section--rule" aria-labelledby="more-title" style="margin-top: var(--section)">
      <div class="container">
        <div class="section-head">
          <h2 class="h-section" id="more-title">More writing</h2>
          <a class="link-arrow" href="/writing/">All writing <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="post-grid">
          {others.map((p, i) => <PostCard post={p} index={i + 1} />)}
        </div>
      </div>
    </section>
  )}
</Base>
