---
// WRITING PAGE. Finished articles are listed newest first. Articles still marked
// "placeholder: true" are hidden from visitors (you see them with ?preview).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import Newsletter from '../../components/Newsletter.astro';
import { photo } from '../../lib/photos';
import { getPosts } from '../../lib/posts';
import { formatDate, readingTime, isPlaceholder } from '../../lib/util';

const all = await getPosts();
const real = all.filter((p) => !p.data.placeholder);
const posts = [...real, ...all.filter((p) => p.data.placeholder)];
const [latest, ...rest] = posts;
const latestCover = latest && photo(`writing/${latest.id}`);
---
<Base title="Writing" description="Essays by Sajid Kamal on building brands, retail and how people in Bangladesh shop.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h1 class="page-title">Notes from <em>the shelf</em>.</h1>
      <p class="lead">Essays on building brands in Bangladesh: launches that worked, ones that didn’t, and what shoppers taught me along the way.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {real.length === 0 && (
        <div class="coming-soon visitor-only">
          <h2 class="h-section">The first essays are <em>on their way</em>.</h2>
          <p class="lead">On brand building, trade programs and starting a company in Bangladesh. Follow along to read them first.</p>
        </div>
      )}

      {latest && (
        <>
          <a class="feature" href={`/writing/${latest.id}/`} data-draft={latest.data.placeholder ? '' : undefined}>
            <div class="feature__media" transition:name={`post-media-${latest.id}`}>
              {latestCover ? (
                <Image src={latestCover} alt="" widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 52vw" />
              ) : (
                <CoverArt kicker={`Essay · ${formatDate(latest.data.date, 'short')}`} value={latest.data.topic} tone={3} variant="title" />
              )}
            </div>
            <div>
              <p class="eyebrow">Latest · {latest.data.topic}</p>
              <h2 class="feature__title">{latest.data.title}</h2>
              <p class:list={['feature__excerpt', isPlaceholder(latest.data.excerpt) && 'placeholder']}>{latest.data.excerpt}</p>
              <p class="meta">{formatDate(latest.data.date)} · {readingTime(latest.body)}</p>
              <span class="link-arrow">Read the essay <span class="arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
          <div class="post-list" data-draft={rest.some((p) => !p.data.placeholder) ? undefined : ''}>
            {rest.map((post) => (
              <article class="post-row" data-reveal data-draft={post.data.placeholder ? '' : undefined}>
                <a class="post-row__link" href={`/writing/${post.id}/`}>
                  <time class="post-row__date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short')}</time>
                  <div>
                    <h3 class="post-row__title">{post.data.title}</h3>
                    <p class:list={['post-row__excerpt', isPlaceholder(post.data.excerpt) && 'placeholder']}>{post.data.excerpt}</p>
                  </div>
                  <p class="post-row__meta">{post.data.topic}<br />{readingTime(post.body)}</p>
                </a>
              </article>
            ))}
          </div>
        </>
      )}
      <Newsletter />
    </div>
  </section>
</Base>
