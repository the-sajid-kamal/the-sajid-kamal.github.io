---
// SERVICES PAGE (consulting, advisory and speaking). Content: src/data/services.ts
// Hide it with showServices: false in src/site.config.ts.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../site.config';
import { services, formats, process, faq } from '../data/services';
import { resolveHref, isExternal, isPlaceholder } from '../lib/util';
const booking = resolveHref('booking');
---
{site.showServices ? (
  <Base title="Services" description="Consulting, advisory and speaking from Sajid Kamal: category and brand strategy, go-to-market, trade marketing, campaigns, brand P&L and startup advisory.">
    <section class="page-head">
      <div class="container">
        <p class="eyebrow">Services</p>
        <h1 class="page-title">Practical help for brands that want to <em>grow</em>.</h1>
        <p class="lead">For founders, marketing teams and businesses in Bangladesh and beyond: strategy you can act on, from someone who builds brands every day.</p>
        <div class="actions" style="margin-top: 2rem">
          <a class="btn btn--primary" href={booking} target={isExternal(booking) ? '_blank' : undefined} rel={isExternal(booking) ? 'noopener' : undefined}>Book an intro call</a>
          <a class="link-arrow" href="/work/">See the work behind it <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="services-title">
      <div class="container">
        <SectionHead num="01" id="services-title" title="What I can help with" />
        <div class="services-grid">
          {services.map((s, i) => (
            <article class="service-card" data-reveal>
              <span class="service-card__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
              <p class="service-card__proof"><strong>Done before</strong>{s.proof}</p>
              {s.work && <a class="link-arrow service-card__link" href={`/work/${s.work}/`}>Related case study <span class="arrow" aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="formats-title">
      <div class="container">
        <SectionHead num="02" id="formats-title" title="Ways to work together" />
        <div class="formats">
          {formats.map((f) => (
            <article class="format-card" data-reveal>
              <span class:list={['format-card__length', isPlaceholder(f.length) && 'placeholder']}>{f.length}</span>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
              <p class:list={['format-card__price', isPlaceholder(f.price) && 'placeholder']}>{f.price}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="process-title">
      <div class="container">
        <SectionHead num="03" id="process-title" title="How it works" />
        <ol class="steps">
          {process.map((p) => (
            <li class="step" data-reveal><h3>{p.title}</h3><p>{p.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="faq-title">
      <div class="container container--narrow">
        <SectionHead num="04" id="faq-title" title="Questions" />
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class:list={[isPlaceholder(f.a) && 'placeholder']}>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </Base>
) : (
  <Base title="Services" noindex>
    <section class="page-head"><div class="container"><h1 class="page-title">Let’s talk.</h1><p class="lead"><a class="text-link" href="/contact/">Get in touch</a> about your project.</p></div></section>
  </Base>
)}
