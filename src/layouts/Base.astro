---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// The two fonts the top of every page needs: downloaded straight away
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
// Bangla pages: the heading and text fonts (these only download on /bn/ pages)
import bnSerifFont from '../assets/fonts/tiro-bangla-bengali.woff2?url';
import { site } from '../site.config';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getLang, t } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  person?: boolean;
  hideCta?: boolean;
  noindex?: boolean;
}
const { hideCta = false, ...seo } = Astro.props;
const lang = getLang(Astro.url);
---
<!doctype html>
<html lang={lang} data-palette={site.palette} data-default-palette={site.palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Before the page is drawn: light or dark theme (saved choice, else the device
         setting), plus anything picked in the owner preview (?preview). Re-applied
         after each page change. */
      (function () {
        var d = document.documentElement;
        function apply() {
          var theme = null, preview = {};
          try { theme = localStorage.getItem('theme'); } catch (e) {}
          try { preview = JSON.parse(sessionStorage.getItem('owner-preview') || '{}'); } catch (e) {}
          var palette = new URLSearchParams(location.search).get('palette') || (preview.on && preview.palette);
          if (palette) d.setAttribute('data-palette', palette);
          if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.setAttribute('data-theme', theme);
          d.classList.toggle('outline-placeholders', !!(preview.on && preview.placeholders));
          d.classList.add('js');
        }
        apply();
        if (!window.__siteThemeHook) {
          window.__siteThemeHook = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    {lang === 'bn' ? (
      <>
        <link rel="preload" href={bnSerifFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <>
        <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
      </>
    )}
    <Seo {...seo} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/writing/feed.xml" />
    <meta name="theme-color" content="#F6F1E9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)" />
    <Analytics />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <span class="scroll-progress" aria-hidden="true"></span>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!hideCta && <CtaBand />}
    <Footer />
    <WhatsAppButton />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
