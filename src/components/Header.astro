---
import { site } from '../site.config';

const nav = [
  { label: 'Work', href: '/work/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'About', href: '/about/' },
  ...(site.showServices ? [{ label: 'Services', href: '/services/' }] : []),
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="wordmark" href="/">{site.name}<span class="wordmark__dot" aria-hidden="true">.</span></a>

    <nav class="site-nav" id="site-menu" aria-label="Main">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="site-nav__cta"><a class="btn btn--primary" href="/contact/">Work with me</a></li>
      </ul>
    </nav>

    <div class="header-tools">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6" stroke-linecap="round"></path></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8 8.4 8.4 0 1 0 20.2 14.6Z" stroke-linejoin="round"></path></svg>
      </button>
      <a class="btn btn--primary btn--small" href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Work with me</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span data-menu-label>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
