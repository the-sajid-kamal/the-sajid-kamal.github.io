---
// Four big numbers. The final values are in the HTML; they count up when scrolled into view.
import { stats } from '../data/home';
---
<ul class="stats">
  {stats.map((s) => (
    <li class="stat" data-reveal>
      <span class="stat__value"><span data-count={s.value}>{s.value}</span>{s.suffix && <em>{s.suffix}</em>}</span>
      <span class="stat__label">{s.label}</span>
    </li>
  ))}
</ul>
