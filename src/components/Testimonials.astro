---
import { testimonials as en } from '../data/home';
import { testimonials as bn } from '../data/bn';
import { getLang } from '../i18n/ui';
import { isPlaceholder } from '../lib/util';
const testimonials = getLang(Astro.url) === 'bn' ? bn : en;
---
{testimonials.length > 0 && (
  <div class="quotes">
    {testimonials.map((t) => (
      <figure class="quote-card" data-reveal>
        <blockquote class:list={[isPlaceholder(t.quote) && 'placeholder']}>{t.quote}</blockquote>
        <figcaption class:list={[isPlaceholder(t.name) && 'placeholder']}><strong>{t.name}</strong>{t.role}</figcaption>
      </figure>
    ))}
  </div>
)}
