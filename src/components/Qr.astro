---
// A QR code drawn at build time (no image to download). Used on the printable résumé
// and the one-pager, so a printed copy leads back to the site (tracked as a print visit).
import QRCode from 'qrcode';
interface Props { url: string; label?: string; size?: number }
const { url, label, size = 92 } = Astro.props;
const svg = await QRCode.toString(url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1F1B16', light: '#FFFFFF' } });
---
<figure class="qr">
  <span class="qr__code" style={`width:${size}px;height:${size}px`} set:html={svg} />
  {label && <figcaption>{label}</figcaption>}
</figure>
