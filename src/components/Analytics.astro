---
// Analytics tools. The IDs live in src/site.config.ts → analytics ('' switches one off).
import { site } from '../site.config';
const { gtm, umami, clarity, cloudflare } = site.analytics;
---
{gtm && (
  <script is:inline define:vars={{ gtm }}>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtm);
  </script>
)}
{umami && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umami}></script>}
{clarity && (
  <script is:inline define:vars={{ clarity }}>
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarity);
  </script>
)}
{cloudflare && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cloudflare })}></script>
)}
