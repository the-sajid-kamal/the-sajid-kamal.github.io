---
// "How I can help": one tab per kind of visitor. Content lives in src/data/home.ts
// (Bangla: src/data/bn.ts). Without JavaScript the panels simply stack, so nothing is ever hidden.
import { audiences as en } from '../data/home';
import { audiences as bn } from '../data/bn';
import { getLang } from '../i18n/ui';
import { resolveHref, isExternal, isPlaceholder } from '../lib/util';
const lang = getLang(Astro.url);
const audiences = lang === 'bn' ? bn : en;
---
<div class="audience" data-tabs>
  <div class="audience__tabs" role="tablist" aria-label={lang === 'bn' ? 'আমি এসেছি' : 'I’m here for'}>
    {audiences.map((a, i) => (
      <button class="audience__tab" type="button" role="tab" id={`tab-${a.id}`} aria-controls={a.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{a.tab}</button>
    ))}
    <span class="audience__indicator" aria-hidden="true"></span>
  </div>
  {audiences.map((a) => {
    const primary = resolveHref(a.primary.href, lang);
    const secondary = resolveHref(a.secondary.href, lang);
    return (
      <section class="audience__panel" id={a.id} role="tabpanel" aria-labelledby={`tab-${a.id}`} data-zone={a.id}>
        <div class="audience__pitch">
          <p class="eyebrow">{a.eyebrow}</p>
          <h3 class="audience__title">{a.title}</h3>
          <p>{a.text}</p>
          <div class="actions">
            <a class="btn btn--primary" href={primary} download={a.primary.href === 'cv' ? '' : undefined} data-astro-reload={a.primary.href === 'cv' ? '' : undefined}>{a.primary.label}</a>
            <a class="link-arrow" href={secondary} target={isExternal(secondary) ? '_blank' : undefined} rel={isExternal(secondary) ? 'noopener' : undefined}>{a.secondary.label} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
        <ul class="proof-list">
          {a.proof.map((p) => (
            <li class:list={['proof-item', isPlaceholder(p.label) && 'placeholder']}>
              <span class="proof-item__value">{p.value}</span>
              <span class="proof-item__label">{p.label}</span>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>
