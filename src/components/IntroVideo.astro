---
// HIDDEN FOR NOW: switch on with video.show in src/site.config.ts.
// Until a YouTube ID is set, a placeholder box shows. The video itself only loads when
// someone presses play, so it costs nothing until then.
import { site } from '../site.config';
import { getLang, t } from '../i18n/ui';
import SectionHead from './SectionHead.astro';
const lang = getLang(Astro.url);
const s = t(lang).video;
const { show, youtubeId, title } = site.video;
const heading = title[lang];
---
{show && (
  <section class="section section--rule" aria-labelledby="video-title" data-zone="video">
    <div class="container">
      <SectionHead id="video-title" title={heading} />
      {youtubeId ? (
        <div class="video" data-video={youtubeId} data-video-title={heading}>
          <button class="video__play" type="button" data-video-play aria-label={`${s.play}: ${heading}`}>
            <img src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`} alt="" loading="lazy" decoding="async" width="1280" height="720" />
            <span class="video__icon" aria-hidden="true"></span>
          </button>
          <noscript><a class="text-link" href={`https://www.youtube.com/watch?v=${youtubeId}`}>{heading}</a></noscript>
        </div>
      ) : (
        <div class="video ph-box" data-placeholder role="img" aria-label={s.placeholder}>{s.placeholder}</div>
      )}
    </div>
  </section>
)}
