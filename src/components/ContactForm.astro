---
// Contact form. Sends to /api/contact (functions/api/contact.js on Cloudflare Pages).
// The topic can be pre-selected with a link like /contact/?topic=consulting#message
import { site } from '../site.config';

const topics = [
  { value: 'hiring', label: 'A role or hiring' },
  { value: 'consulting', label: 'Consulting or advisory' },
  { value: 'venture', label: 'Investment or a venture' },
  { value: 'speaking', label: 'Speaking or media' },
  { value: 'other', label: 'Something else' },
];
const { endpoint, turnstileSiteKey } = site.contactForm;
---
<form class="form" method="post" action={endpoint} data-contact-form data-fallback-email={site.email} data-astro-reload>
  <div class="form__row">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="topic">What is it about?</label>
      <select id="topic" name="topic">
        {topics.map((t) => <option value={t.value}>{t.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="organisation">Organisation <span class="optional">(optional)</span></label>
      <input id="organisation" name="organisation" type="text" autocomplete="organization" maxlength="150" />
    </div>
  </div>
  <div class="field">
    <label for="message-body">Message</label>
    <textarea id="message-body" name="message" rows="6" required maxlength="5000"></textarea>
  </div>
  <!-- Spam trap: hidden from people. Messages where a bot fills it in are dropped. -->
  <div class="honeypot" aria-hidden="true">
    <label for="website">Website</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>}
  <button class="btn btn--primary" type="submit">Send message <span class="arrow" aria-hidden="true">→</span></button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
